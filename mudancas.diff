+/**********************************/
+/************ faq CSS *************/
+/**********************************/
+.faq {
+    position: relative;
+    padding: 60px 30px 30px 30px;
+    background: #ffffff;
+    border-bottom: 30px solid #373737;
+}
+
+.faq-list {
+    position: relative;
+    width: 100%;
+}
+
+.faq-item {
+    border-bottom: 1px solid #e6e6e6;
+}
